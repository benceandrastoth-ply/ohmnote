{
  "name": "ohmnote",
  "productName": "OhmNote",
  "version": "0.2.2",
  "description": "A notebook for electronics: schematics, sketches and notes on the same page.",
  "main": "main.js",
  "author": {
    "name": "OhmNote contributors",
    "email": "ohmnote@users.noreply.github.com"
  },
  "homepage": "https://benceandrastoth-ply.github.io/ohmnote/",
  "repository": {
    "type": "git",
    "url": "https://github.com/benceandrastoth-ply/ohmnote.git"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis",
    "dist:linux": "electron-builder --linux deb rpm pacman AppImage",
    "android:sync": "cap sync android",
    "android:debug": "node scripts/android-build.js debug",
    "android:release": "node scripts/android-build.js release",
    "android:icons": "electron scripts/android-icons.js"
  },
  "build": {
    "appId": "app.ohmnote.desktop",
    "productName": "OhmNote",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "!**/node_modules/@capacitor/**"
    ],
    "fileAssociations": [
      {
        "ext": "ohm",
        "name": "OhmNote Project",
        "mimeType": "application/x-ohmnote"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OhmNote-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "OhmNote-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "pacman",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "OhmNote contributors <ohmnote@users.noreply.github.com>",
      "vendor": "OhmNote",
      "synopsis": "A notebook for electronics",
      "description": "Draw schematics, sketch by hand and write notes on the same page. Part library, wires, parts list, calculator, handwriting fonts and notebook scans.",
      "desktop": {
        "entry": {
          "StartupWMClass": "OhmNote",
          "Keywords": "electronics;schematic;circuit;notebook;notes;"
        }
      }
    },
    "deb": {
      "artifactName": "ohmnote_${version}_amd64.deb"
    },
    "rpm": {
      "artifactName": "ohmnote-${version}.x86_64.rpm"
    },
    "pacman": {
      "artifactName": "ohmnote-${version}-x86_64.pkg.tar.zst"
    },
    "appImage": {
      "artifactName": "OhmNote-${version}-x86_64.AppImage"
    },
    "icon": "build/icon.png",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@supabase/supabase-js": "^2.119.2",
    "clipper-lib": "^6.4.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "opentype.js": "^2.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3"
  }
}
